{
	"info": {
		"_postman_id": "YOUR_POSTMAN_COLLECTION_ID_HERE",
		"name": "IntelliAPI",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Get Anonymous Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Mobile-App-Key",
								"value": "YOUR_MOBILE_APP_KEY_HERE",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/anonymous-token?deviceId=YOUR_DEVICE_ID_HERE",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"anonymous-token"
							],
							"query": [
								{
									"key": "deviceId",
									"value": "YOUR_DEVICE_ID_HERE"
								}
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"try {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData && jsonData.token) {",
									"        pm.environment.set(\"jwt_token\", jsonData.token);",
									"        console.log(\"JWT token captured and set to environment variable 'jwt_token'\");",
									"    } else {",
									"        console.error(\"Failed to find 'token' in JSON response for /auth/anonymous-token\");",
									"    }",
									"} catch (e) {",
									"    console.error(\"Error parsing JSON response for /auth/anonymous-token: \" + e);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "Search",
			"item": [
				{
					"name": "Search Intelli",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"inputText\": \"java\",\n    \"mode\": \"tech\",\n    \"language\": \"en\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/intelli/search",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"intelli",
								"search"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	]
}
